#include "mbed.h"

// PullDown ensures the pin reads 0 (LOW) when the button is not being pressed.
DigitalIn btn0(D2, PullDown); 
DigitalIn btn1(D3, PullDown);
DigitalIn btn2(D4, PullDown); 
DigitalIn btn3(D5, PullDown);
DigitalIn btn4(D6, PullDown); 
DigitalIn btn5(D7, PullDown);

DigitalOut warningLED(LED1);     
DigitalOut lockdownSolid(LED2);  
DigitalOut lockdownBlink(LED3);  

DigitalOut logLED1(D8);          
DigitalOut logLED2(D9);          
DigitalOut logLED3(D10);         


// Passcode configurations
int userCode[4] = {0, 1, 2, 3};         // Standard access code
int adminCode[4] = {5, 4, 3, 2};        // Override code for lockdown
int enteredCode[4] = {-1, -1, -1, -1};  // Buffer to store the user's current input

// System trackers
int wrong_attempts = 0;   // Counts consecutive failed logins
int lockdown_count = 0;   // Tracks total number of lockdowns for the event log
int press_count = 0;      // Tracks how many digits the user has currently entered

int system_mode = 0; 


int read_buttons() {
    if (btn0 == 1) return 0; 
    if (btn1 == 1) return 1; 
    if (btn2 == 1) return 2;
    if (btn3 == 1) return 3; 
    if (btn4 == 1) return 4; 
    if (btn5 == 1) return 5;
    
    return -1; // Default return if nothing is pressed
}

bool check_passcode(int expectedCode[]) {
    for (int i = 0; i < 4; i++) {
        if (enteredCode[i] != expectedCode[i]) {
            return false; // Stop checking on the first wrong digit
        }
    }
    return true; 
}

void update_log_leds() {
    logLED1 = (lockdown_count & 0x01);       // Isolate Bit 0
    logLED2 = (lockdown_count & 0x02) >> 1;  // Isolate Bit 1 and shift to position 0
    logLED3 = (lockdown_count & 0x04) >> 2;  // Isolate Bit 2 and shift to position 0
}


int main() {
    while (true) {
        
        switch (system_mode) {


            // STATE 0: NORMAL OPERATING MODE
            case 0: { 
                int pressed = read_buttons();
                
                if (pressed != -1) {
                    enteredCode[press_count] = pressed;
                    press_count++;
                    thread_sleep_for(200); // 200ms delay prevents double-registering one press
                }
                
                // Evaluate the code once 4 digits have been entered
                if (press_count == 4) {
                    
                    if (check_passcode(userCode) == true) {
                        wrong_attempts = 0; // If passcode input is successful, reset the strike counter
                    } else {
                        wrong_attempts++;   
                    }
                    
                    press_count = 0; // Clear the input buffer for the next attempt
                    
                    if (wrong_attempts == 3) {
                        system_mode = 1; // Trigger 30s warning
                    } 
                    else if (wrong_attempts >= 4) {
                        system_mode = 2; // Trigger 60s lockdown
                        lockdown_count++;
                        update_log_leds(); // Update the binary tracker
                    }
                }
                break;
            }


            case 1: { 
                for (int i = 0; i < 30; i++) {
                    warningLED = !warningLED; 
                    thread_sleep_for(1000);   
                }
                
                // Warning period is over. Reset to normal to await the 4th attempt
                warningLED = 0; 
                system_mode = 0; 
                break;
            }


            case 2: { 
                lockdownSolid = 1; 

                for (int i = 0; i < 600; i++) {
                    
                    // Blink the red LED every 5th cycle (every 500ms)
                    if (i % 5 == 0) {
                        lockdownBlink = !lockdownBlink; 
                    }
                    

                    int admin_press = read_buttons();
                    
                    if (admin_press != -1) {
                        enteredCode[press_count] = admin_press;
                        press_count++;
                        thread_sleep_for(200); // Debounce
                    }
                    

                    if (press_count == 4) {
                        
                        if (check_passcode(adminCode) == true) {
                            // If admin code matches, reset the system immediately.
                            wrong_attempts = 0;
                            system_mode = 0; 
                            press_count = 0;
                            
                            lockdownSolid = 0;
                            lockdownBlink = 0;
                            
                            break; // Break completely out of the 60-second loop
                        } else {
                            // Wrong admin code entered. Clear buffer and keep waiting.
                            press_count = 0; 
                        }
                    }
                    
                    thread_sleep_for(100); 
                }
                
                // If the 60 seconds naturally expires without a successful admin override:
                // Return to normal mode but do not reset the wrong_attempts counter.
                if (system_mode == 2) { 
                    system_mode = 0; 
                    lockdownSolid = 0; 
                    lockdownBlink = 0;
                }
                break;
            }
        }
    }
}
